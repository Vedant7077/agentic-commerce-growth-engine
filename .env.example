# ==============================================================================
# Agentic Commerce Growth Engine — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ==============================================================================

# ── Razorpay (TEST mode) ─────────────────────────────────────────────────────
# Get yours from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# For Render: set DATABASE_URL and leave the individual POSTGRES_* vars unset.
# For local docker compose: leave DATABASE_URL unset and use POSTGRES_* vars.
DATABASE_URL=
POSTGRES_DB=agentic_commerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── n8n Webhook (failure/block alerts) ────────────────────────────────────────
N8N_WEBHOOK_URL=http://n8n:5678/webhook/audit-failure

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_BASE_URL=http://127.0.0.1:8000

# ── Timeout simulation (demo only) ───────────────────────────────────────────
FORCE_TIMEOUT=false

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# Set in frontend/.env.local (not this file)
# NEXT_PUBLIC_API_URL=http://localhost:8000
